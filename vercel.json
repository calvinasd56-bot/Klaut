{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en",                       "destination": "/",                       "permanent": true },
    { "source": "/employee",                 "destination": "/solutions/employee",     "permanent": false },
    { "source": "/id/employee",              "destination": "/id/solutions/employee",  "permanent": false },
    { "source": "/faq",                      "destination": "/help-center",            "permanent": true },
    { "source": "/id/faq",                   "destination": "/id/help-center",         "permanent": true },
    { "source": "/en/faq",                   "destination": "/help-center",            "permanent": true },
    { "source": "/en/articles",              "destination": "/articles",               "permanent": true },
    { "source": "/en/articles/:slug",        "destination": "/articles/:slug",         "permanent": true },
    { "source": "/en/case-studies",          "destination": "/case-studies",           "permanent": true },
    { "source": "/en/case-studies/:slug",    "destination": "/case-studies/:slug",     "permanent": true },
    { "source": "/en/audit-live",            "destination": "/audit-live",             "permanent": true },
    { "source": "/artikel",                  "destination": "/id/artikel",             "permanent": true },
    { "source": "/artikel/:slug",            "destination": "/id/artikel/:slug",       "permanent": true },
    { "source": "/apps",                     "destination": "/marketplace",                                "permanent": true },
    { "source": "/id/apps",                  "destination": "/id/marketplace",                             "permanent": true },
    { "source": "/learning",                 "destination": "/learn",                                      "permanent": true },
    { "source": "/id/learning",              "destination": "/id/learn",                                   "permanent": true },
    { "source": "/capabilities/work-patterns",        "destination": "/work-patterns",        "permanent": true },
    { "source": "/capabilities/error-detection",      "destination": "/error-detection",      "permanent": true },
    { "source": "/capabilities/kpi",                  "destination": "/kpi-command-center",   "permanent": true },
    { "source": "/capabilities/kpi-command-center",   "destination": "/kpi-command-center",   "permanent": true },
    { "source": "/capabilities/reports",              "destination": "/report-card",          "permanent": true },
    { "source": "/capabilities/report-card",          "destination": "/report-card",          "permanent": true },
    { "source": "/capabilities/admin",                "destination": "/admin-security",       "permanent": true },
    { "source": "/capabilities/admin-security",       "destination": "/admin-security",       "permanent": true },
    { "source": "/capabilities/tools-integration",    "destination": "/tools-integration",    "permanent": true },
    { "source": "/id/capabilities/work-patterns",     "destination": "/id/work-patterns",     "permanent": true },
    { "source": "/id/capabilities/error-detection",   "destination": "/id/error-detection",   "permanent": true },
    { "source": "/id/capabilities/kpi",               "destination": "/id/kpi-command-center","permanent": true },
    { "source": "/id/capabilities/kpi-command-center","destination": "/id/kpi-command-center","permanent": true },
    { "source": "/id/capabilities/reports",           "destination": "/id/report-card",       "permanent": true },
    { "source": "/id/capabilities/report-card",       "destination": "/id/report-card",       "permanent": true },
    { "source": "/id/capabilities/admin",             "destination": "/id/admin-security",    "permanent": true },
    { "source": "/id/capabilities/admin-security",    "destination": "/id/admin-security",    "permanent": true },
    { "source": "/id/capabilities/tools-integration", "destination": "/id/tools-integration", "permanent": true }
  ],
  "rewrites": [
    { "source": "/marketplace",              "destination": "https://compass-app.klaut.id/marketplace" },
    { "source": "/id/marketplace",           "destination": "https://compass-app.klaut.id/id/marketplace" },
    { "source": "/why-klaut",                "destination": "https://compass-app.klaut.id/why-klaut" },
    { "source": "/id/why-klaut",             "destination": "https://compass-app.klaut.id/id/why-klaut" },
    { "source": "/learn",                    "destination": "https://compass-app.klaut.id/learn" },
    { "source": "/id/learn",                 "destination": "https://compass-app.klaut.id/id/learn" },
    { "source": "/pricing",                  "destination": "https://compass-app.klaut.id/pricing" },
    { "source": "/id/pricing",               "destination": "https://compass-app.klaut.id/id/pricing" },
    { "source": "/checkout",                 "destination": "https://compass-app.klaut.id/checkout" },
    { "source": "/id/checkout",              "destination": "https://compass-app.klaut.id/checkout" },
    { "source": "/articles/:slug",           "destination": "/articles/article" },
    { "source": "/case-studies/:slug",       "destination": "/case-studies/case-study" },
    { "source": "/id/artikel/:slug",         "destination": "/id/artikel/article" },
    { "source": "/id/case-studies/:slug",    "destination": "/id/case-studies/case-study" }
  ]
}
