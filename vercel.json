{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en",                       "destination": "/",                       "permanent": true },
    { "source": "/employee",                 "destination": "/solutions/employee",     "permanent": false },
    { "source": "/id/employee",              "destination": "/id/solutions/employee",  "permanent": false },
    { "source": "/faq",                      "destination": "/help-center",            "permanent": true },
    { "source": "/id/faq",                   "destination": "/id/help-center",         "permanent": true },
    { "source": "/en/faq",                   "destination": "/help-center",            "permanent": true },
    { "source": "/en/articles",              "destination": "/articles",               "permanent": true },
    { "source": "/en/articles/:slug",        "destination": "/articles/:slug",         "permanent": true },
    { "source": "/en/case-studies",          "destination": "/case-studies",           "permanent": true },
    { "source": "/en/case-studies/:slug",    "destination": "/case-studies/:slug",     "permanent": true },
    { "source": "/en/audit-live",            "destination": "/audit-live",             "permanent": true },
    { "source": "/artikel",                  "destination": "/id/artikel",             "permanent": true },
    { "source": "/artikel/:slug",            "destination": "/id/artikel/:slug",       "permanent": true },
    { "source": "/marketplace",              "destination": "https://compass-app.klaut.id/marketplace",    "permanent": false },
    { "source": "/id/marketplace",           "destination": "https://compass-app.klaut.id/id/marketplace", "permanent": false },
    { "source": "/why-klaut",                "destination": "https://compass-app.klaut.id/why-klaut",      "permanent": false },
    { "source": "/id/why-klaut",             "destination": "https://compass-app.klaut.id/id/why-klaut",   "permanent": false },
    { "source": "/apps",                     "destination": "https://compass-app.klaut.id/apps",           "permanent": false },
    { "source": "/id/apps",                  "destination": "https://compass-app.klaut.id/id/apps",        "permanent": false },
    { "source": "/learn",                    "destination": "https://compass-app.klaut.id/learn",          "permanent": false },
    { "source": "/id/learn",                 "destination": "https://compass-app.klaut.id/id/learn",       "permanent": false }
  ],
  "rewrites": [
    { "source": "/pricing",                  "destination": "https://compass-app.klaut.id/pricing" },
    { "source": "/id/pricing",               "destination": "https://compass-app.klaut.id/id/pricing" },
    { "source": "/checkout",                 "destination": "https://compass-app.klaut.id/checkout" },
    { "source": "/id/checkout",              "destination": "https://compass-app.klaut.id/checkout" },
    { "source": "/articles/:slug",           "destination": "/articles/article" },
    { "source": "/case-studies/:slug",       "destination": "/case-studies/case-study" },
    { "source": "/id/artikel/:slug",         "destination": "/id/artikel/article" },
    { "source": "/id/case-studies/:slug",    "destination": "/id/case-studies/case-study" }
  ]
}
